[Unit]
Description=Dynamic PAC proxy (resolves Charles Mac over mDNS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/dynamic-pac-proxy --config /etc/dynamic-pac-proxy/config.yaml
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
