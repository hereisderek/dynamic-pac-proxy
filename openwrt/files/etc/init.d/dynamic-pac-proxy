#!/bin/sh /etc/rc.common
# OpenWRT procd init script, driven by UCI (/etc/config/dynamic-pac-proxy)
# via LuCI or `uci`. config.yaml is generated from UCI, not edited by hand.

USE_PROCD=1
START=99
STOP=10

PROG=/usr/bin/dynamic-pac-proxy
CONF=/etc/dynamic-pac-proxy/config.yaml
GENERATOR=/usr/lib/dynamic-pac-proxy/uci2yaml.sh

regenerate_config() {
	"$GENERATOR"
}

start_service() {
	local enabled
	config_load dynamic-pac-proxy
	config_get_bool enabled main enabled 1
	[ "$enabled" = "1" ] || return 0

	regenerate_config

	procd_open_instance
	procd_set_param command "$PROG" --config "$CONF"
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	# The daemon itself polls config.yaml's mtime and hot-reloads on its
	# own within a few seconds, so most UCI edits just need regenerating
	# the file — no restart. Only listen_addr needs a real restart, since
	# that means rebinding the status/PAC HTTP listener.
	regenerate_config
}

service_triggers() {
	procd_add_reload_trigger "dynamic-pac-proxy"
}
